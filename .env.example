# Neon PostgreSQL
# Dashboard: https://console.neon.tech
# Paste this into .env or .env.local. Prisma CLI now reads both files.
# Use the non-pooler / direct host if migrate has trouble with the pooler.

DATABASE_URL="postgresql://USER:PASSWORD@ep-PROJECT.REGION.aws.neon.tech/neondb?sslmode=require"

# Signed admin session cookie. Use a long random string.
AUTH_SECRET="replace-with-a-long-random-secret"

# Created once by `npx prisma db seed`. After that, change email
# and password from Admin → Settings.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
